{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/powerpuff-kitty/agentic-harness/schema/preset.schema.json",
  "title": "Agentic Harness Preset",
  "type": "object",
  "required": ["boilerplate"],
  "properties": {
    "boilerplate": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "packs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "skills": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "policies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "profile": {"type": "string"}
  },
  "additionalProperties": false
}
