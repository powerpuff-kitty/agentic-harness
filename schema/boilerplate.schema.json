{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/powerpuff-kitty/agentic-harness/schema/boilerplate.schema.json",
  "title": "Agentic Harness Boilerplate",
  "type": "object",
  "required": ["name", "version", "format_version"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "format_version": {"type": "integer", "minimum": 1},
    "description": {"type": "string"},
    "extends": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "required_core": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "default_packs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "default_skills": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
