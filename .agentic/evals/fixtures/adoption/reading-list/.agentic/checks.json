    {"id": "build", "argv": ["npm", "run", "build"], "cwd": ".", "required": true, "timeout_ms": 120000, "max_output_bytes": 65536},
    {"id": "browser", "argv": ["npm", "run", "test:browser"], "cwd": ".", "required": true, "timeout_ms": 120000, "max_output_bytes": 131072}
  ],
  "required_controls": [],
  "max_age_ms": 3600000
}
