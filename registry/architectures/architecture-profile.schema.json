{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-harness.dev/schemas/architecture-profile.schema.json",
  "title": "Agentic Harness Architecture Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "name",
    "version_selector",
    "authority",
    "reviewed_at",
    "rules",
    "sources"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$" },
    "kind": {
      "type": "string",
      "enum": ["framework", "ecosystem", "tooling", "pattern"]
    },
    "name": { "type": "string", "minLength": 1 },
    "version_selector": { "type": "string", "minLength": 1 },
    "authority": {
      "type": "string",
      "enum": ["official", "ecosystem-official", "harness", "community"]
    },
    "reviewed_at": { "type": "string", "format": "date" },
    "description": { "type": "string" },
    "composes_with": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "rule_type",
        "severity",
        "enforceability",
        "authority",
        "summary",
        "source_refs",
        "constraints"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "rule_type": {
          "type": "string",
          "enum": [
            "organization",
            "path-role",
            "path-presence",
            "file-placement",
            "dependency-boundary",
            "module-boundary",
            "ownership",
            "tooling-role"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["error", "warning", "recommendation"]
        },
        "enforceability": {
          "type": "string",
          "enum": ["deterministic", "heuristic", "advisory"]
        },
        "authority": {
          "type": "string",
          "enum": ["official", "ecosystem-official", "harness", "community"]
        },
        "summary": { "type": "string", "minLength": 1 },
        "source_refs": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "constraints": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "authority", "reviewed_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "authority": {
          "type": "string",
          "enum": ["official", "ecosystem-official", "harness", "community"]
        },
        "reviewed_at": { "type": "string", "format": "date" },
        "notes": { "type": "string" }
      }
    }
  }
}
