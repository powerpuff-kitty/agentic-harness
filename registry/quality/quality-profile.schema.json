{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-harness.dev/schemas/quality-profile.schema.json",
  "title": "Agentic Harness Quality Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "name",
    "version_selector",
    "authority",
    "reviewed_at",
    "capabilities",
    "rules",
    "sources"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$" },
    "kind": {
      "type": "string",
      "enum": ["language", "framework", "tooling", "pattern"]
    },
    "name": { "type": "string", "minLength": 1 },
    "version_selector": { "type": "string", "minLength": 1 },
    "authority": {
      "type": "string",
      "enum": ["official", "ecosystem-official", "harness", "community"]
    },
    "reviewed_at": { "type": "string", "format": "date" },
    "description": { "type": "string" },
    "composes_with": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["detect", "analyze", "check", "fix", "baseline", "diff"]
      },
      "uniqueItems": true
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "category",
        "severity",
        "enforceability",
        "authority",
        "summary",
        "source_refs",
        "tools",
        "autofix",
        "constraints"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "category": {
          "type": "string",
          "enum": [
            "formatting",
            "linting",
            "type-safety",
            "complexity",
            "duplication",
            "dead-code",
            "dependency-hygiene",
            "naming",
            "documentation",
            "error-handling",
            "configuration"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["error", "warning", "recommendation"]
        },
        "enforceability": {
          "type": "string",
          "enum": ["deterministic", "heuristic", "advisory"]
        },
        "authority": {
          "type": "string",
          "enum": ["official", "ecosystem-official", "harness", "community"]
        },
        "summary": { "type": "string", "minLength": 1 },
        "source_refs": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "tools": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "autofix": {
          "type": "string",
          "enum": ["none", "safe", "conditional"]
        },
        "constraints": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "authority", "reviewed_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "authority": {
          "type": "string",
          "enum": ["official", "ecosystem-official", "harness", "community"]
        },
        "reviewed_at": { "type": "string", "format": "date" },
        "notes": { "type": "string" }
      }
    }
  }
}
