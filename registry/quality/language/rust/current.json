      "id": "rust.configuration.tooling-evidence",
      "title": "Keep Rust tooling evidence explicit",
      "category": "configuration",
      "severity": "recommendation",
      "enforceability": "advisory",
      "authority": "harness",
      "summary": "Rust quality reports should distinguish Cargo/rustfmt/Clippy configuration discovery from commands that were actually executed.",
      "source_refs": ["harness.quality-evidence"],
      "tools": ["cargo", "rustfmt", "clippy"],
      "autofix": "none",
      "constraints": {
        "discovery_is_execution": false
      }
    }
  ],
