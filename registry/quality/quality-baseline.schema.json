{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-harness.dev/schemas/quality-baseline.schema.json",
  "title": "Agentic Harness Quality Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "kind",
    "created_at",
    "target",
    "contract_digest",
    "tools",
    "findings",
    "metrics",
    "coverage"
  ],
  "properties": {
    "format_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "quality-baseline" },
    "created_at": { "type": "string", "format": "date-time" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "revision": { "type": ["string", "null"] },
        "tree_digest": { "type": ["string", "null"] }
      }
    },
    "contract_digest": { "type": "string", "minLength": 1 },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "config_digest"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": ["string", "null"] },
          "config_digest": { "type": ["string", "null"] }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint", "rule_id", "severity", "path"],
        "properties": {
          "fingerprint": { "type": "string", "minLength": 1 },
          "rule_id": { "type": "string", "minLength": 1 },
          "native_code": { "type": ["string", "null"] },
          "severity": { "type": "string", "enum": ["error", "warning", "recommendation"] },
          "path": { "type": "string", "minLength": 1 },
          "line": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["performed", "not_checked", "unsupported"],
      "properties": {
        "performed": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "not_checked": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "unsupported": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    }
  }
}
