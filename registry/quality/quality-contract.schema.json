{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-harness.dev/schemas/quality-contract.schema.json",
  "title": "Agentic Harness Project Quality Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "kind", "profiles", "checks", "thresholds", "ratchet", "fix_policy", "exceptions"],
  "properties": {
    "format_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "quality-contract" },
    "profiles": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$" },
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "thresholds": {
      "type": "array",
      "items": { "$ref": "#/$defs/threshold" }
    },
    "ratchet": { "$ref": "#/$defs/ratchet" },
    "fix_policy": { "$ref": "#/$defs/fixPolicy" },
    "generated_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "default": []
    },
    "exceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/exception" }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capability", "required"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "capability": { "type": "string", "enum": ["analyze", "check"] },
        "required": { "type": "boolean" },
        "scope": {
          "type": "string",
          "enum": ["repository", "changed-files"],
          "default": "repository"
        }
      }
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "level", "value"],
      "properties": {
        "metric": {
          "type": "string",
          "enum": [
            "cyclomatic-complexity",
            "cognitive-complexity",
            "nesting-depth",
            "function-lines",
            "file-lines",
            "parameter-count",
            "duplication-percent"
          ]
        },
        "level": { "type": "string", "enum": ["advisory", "error"] },
        "value": { "type": "number", "minimum": 0 },
        "scope": { "type": "string", "default": "**/*" }
      }
    },
    "ratchet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "fail_on_new_findings", "fail_on_increased_severity", "fail_on_increased_metric"],
      "properties": {
        "mode": { "type": "string", "enum": ["none", "baseline", "changed-code"] },
        "baseline_path": { "type": ["string", "null"] },
        "fail_on_new_findings": { "type": "boolean" },
        "fail_on_increased_severity": { "type": "boolean" },
        "fail_on_increased_metric": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "baseline" } } },
          "then": { "required": ["baseline_path"], "properties": { "baseline_path": { "type": "string", "minLength": 1 } } }
        }
      ]
    },
    "fixPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_autofix", "default_scope"],
      "properties": {
        "allow_autofix": { "type": "boolean" },
        "default_scope": { "type": "string", "enum": ["none", "changed-files", "explicit-paths"] }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "path", "reason", "expires_at"],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "owner": { "type": ["string", "null"] },
        "expires_at": { "type": "string", "format": "date" }
      }
    }
  }
}
