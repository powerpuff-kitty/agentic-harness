{
  "format_version": 1,
  "kind": "memory-provider",
  "id": "memory-provider:remote-service",
  "mode": "remote",
  "storage": "service",
  "capabilities": {
    "lexical_search": true,
    "semantic_search": true,
    "upsert": true,
    "invalidate": true,
    "consolidate": true,
    "reverify": true
  },
  "sensitivity_policy": {
    "accepted_levels": ["project", "team", "org"],
    "enforce_before_remote_handoff": true
  },
  "configuration_ref": "config://memory/remote-service"
}
