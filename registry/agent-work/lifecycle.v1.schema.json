{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-harness.dev/schemas/agent-work/lifecycle.v1.schema.json",
  "title": "Agent Work Lifecycle Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "kind", "id", "states", "entities", "progress"],
  "properties": {
    "format_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "agent-work-lifecycle" },
    "id": { "$ref": "#/$defs/id" },
    "states": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 10,
      "items": { "$ref": "#/$defs/state" }
    },
    "entities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work-unit", "run", "task", "attempt"],
      "properties": {
        "work-unit": { "$ref": "#/$defs/entity_policy" },
        "run": { "$ref": "#/$defs/entity_policy" },
        "task": { "$ref": "#/$defs/entity_policy" },
        "attempt": { "$ref": "#/$defs/entity_policy" }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "active_plan_only", "persist_percentage"],
      "properties": {
        "basis": { "type": "string", "const": "latest-plan-task-state-counts" },
        "active_plan_only": { "type": "boolean", "const": true },
        "persist_percentage": { "type": "boolean", "const": false }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$" },
    "state": {
      "type": "string",
      "enum": ["proposed", "queued", "running", "validating", "completed", "blocked", "waiting_for_user", "waiting_for_approval", "failed", "cancelled"]
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/state" },
        "to": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/state" }
        }
      }
    },
    "entity_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_states", "terminal_states", "transitions"],
      "properties": {
        "initial_states": {
          "type": "array", "uniqueItems": true, "minItems": 1,
          "items": { "$ref": "#/$defs/state" }
        },
        "terminal_states": {
          "type": "array", "uniqueItems": true, "minItems": 1,
          "items": { "$ref": "#/$defs/state" }
        },
        "transitions": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/transition" }
        }
      }
    }
  }
}
