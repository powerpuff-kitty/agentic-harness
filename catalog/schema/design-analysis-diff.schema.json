{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/design-analysis-diff.schema.json",
  "title": "Agentic Harness Design Analysis Diff",
  "description": "Deterministic comparison of two Design Analysis format-v1 artifacts. Drift evidence is not a subjective design-quality score.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "kind", "before", "after", "domains", "finding_changes", "check_changes", "observations", "metadata"],
  "properties": {
    "format_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "design-analysis-diff"},
    "before": {"$ref": "#/$defs/analysisRef"},
    "after": {"$ref": "#/$defs/analysisRef"},
    "domains": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/domainDiff"}
    },
    "finding_changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "removed"],
      "properties": {
        "added": {"type": "array", "items": {"type": "string"}},
        "removed": {"type": "array", "items": {"type": "string"}}
      }
    },
    "check_changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["newly_performed", "no_longer_performed", "newly_unchecked", "no_longer_unchecked"],
      "properties": {
        "newly_performed": {"type": "array", "items": {"type": "string"}},
        "no_longer_performed": {"type": "array", "items": {"type": "string"}},
        "newly_unchecked": {"type": "array", "items": {"type": "string"}},
        "no_longer_unchecked": {"type": "array", "items": {"type": "string"}}
      }
    },
    "observations": {
      "type": "array",
      "items": {"$ref": "#/$defs/observation"}
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["deterministic", "quality_score", "note"],
      "properties": {
        "deterministic": {"type": "boolean", "const": true},
        "quality_score": {"type": "null"},
        "note": {"type": "string"}
      }
    }
  },
  "$defs": {
    "analysisRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "analysis_id", "generated_at"],
      "properties": {
        "source": {"type": "object", "additionalProperties": true},
        "analysis_id": {"type": ["string", "null"]},
        "generated_at": {"type": ["string", "null"]}
      }
    },
    "countedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "count"],
      "properties": {
        "value": {"type": "string"},
        "count": {"type": "integer", "minimum": 0}
      }
    },
    "changedCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "before", "after", "delta"],
      "properties": {
        "value": {"type": "string"},
        "before": {"type": "integer", "minimum": 0},
        "after": {"type": "integer", "minimum": 0},
        "delta": {"type": "integer"}
      }
    },
    "domainDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added_values", "removed_values", "changed_counts", "before_unique_values", "after_unique_values"],
      "properties": {
        "added_values": {"type": "array", "items": {"$ref": "#/$defs/countedValue"}},
        "removed_values": {"type": "array", "items": {"$ref": "#/$defs/countedValue"}},
        "changed_counts": {"type": "array", "items": {"$ref": "#/$defs/changedCount"}},
        "before_unique_values": {"type": "integer", "minimum": 0},
        "after_unique_values": {"type": "integer", "minimum": 0}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "domain", "classification", "severity", "statement", "source_type", "confidence"],
      "properties": {
        "id": {"type": "string"},
        "domain": {"type": "string"},
        "classification": {"type": "string", "const": "observation"},
        "severity": {"type": "string", "enum": ["critical", "high", "medium", "low", "info"]},
        "statement": {"type": "string"},
        "source_type": {"type": "string", "enum": ["static", "runtime", "import", "human", "ai"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
