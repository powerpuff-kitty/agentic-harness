{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-harness.dev/schema/stage-routing-evidence.v1.schema.json",
  "title": "Agentic Harness advisory stage-routing evidence v1",
  "description": "Advisory stage/mechanism selection evidence. A valid record never authorizes execution or consequential action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "kind",
    "id",
    "created_at",
    "stage_class",
    "deterministic_exact_answer_available",
    "selected",
    "evidence_status",
    "model_registry_ref",
    "evaluation_refs",
    "measured_quality",
    "measured_cost_microunits",
    "advisory",
    "execution_authorized",
    "reason"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "kind": {
      "const": "stage-routing-evidence"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "stage_class": {
      "enum": [
        "deterministic-tool",
        "retrieval-indexing",
        "summarization",
        "reasoning-implementation",
        "review"
      ]
    },
    "deterministic_exact_answer_available": {
      "type": "boolean"
    },
    "selected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "deterministic-tool",
            "model",
            "provider",
            "human"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "evidence_status": {
      "enum": [
        "unmeasured",
        "project-evaluated"
      ]
    },
    "model_registry_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "evaluation_refs": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "measured_quality": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "measured_cost_microunits": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "advisory": {
      "const": true
    },
    "execution_authorized": {
      "const": false
    },
    "reason": {
      "$ref": "#/$defs/text"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.:/+@-]+$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "digest"
      ],
      "properties": {
        "reference": {
          "$ref": "#/$defs/text"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
