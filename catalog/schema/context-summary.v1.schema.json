{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-harness.dev/schema/context-summary.v1.schema.json",
  "title": "Agentic Harness hierarchical context summary v1",
  "description": "Generated navigation/analysis summary with exact source provenance. It is never approved project truth merely because it validates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "kind",
    "id",
    "authority",
    "created_at",
    "producer",
    "scope",
    "sources",
    "coverage",
    "summary",
    "summary_sha256"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "kind": {
      "const": "context-summary"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "authority": {
      "const": "generated-non-canonical"
    },
    "created_at": {
      "$ref": "#/$defs/date_time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "deterministic",
            "model",
            "provider",
            "human"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "identity",
        "ancestry"
      ],
      "properties": {
        "level": {
          "enum": [
            "repository",
            "package",
            "module",
            "file",
            "symbol"
          ]
        },
        "identity": {
          "$ref": "#/$defs/text"
        },
        "ancestry": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "level",
              "identity"
            ],
            "properties": {
              "level": {
                "enum": [
                  "repository",
                  "package",
                  "module",
                  "file"
                ]
              },
              "identity": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "missing",
        "not_checked"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "missing": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "not_checked": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "summary": {
      "$ref": "#/$defs/text"
    },
    "summary_sha256": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.:/+@-]+$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "date_time": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "reference",
        "digest",
        "revision",
        "required"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": [
            "source",
            "configuration",
            "rule",
            "decision",
            "diagnostic"
          ]
        },
        "reference": {
          "$ref": "#/$defs/text"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "revision": {
          "oneOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    }
  }
}
