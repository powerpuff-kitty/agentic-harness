{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-harness.dev/schema/context-cache-entry.v1.schema.json",
  "title": "Agentic Harness semantic/analysis cache entry v1",
  "description": "Immutable recorded cache candidate identity. Validation or matching inputs never grants reuse, execution, or consequence authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "kind",
    "id",
    "authority",
    "created_at",
    "artifact_type",
    "repository",
    "producer",
    "inputs",
    "result",
    "identity_sha256"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "kind": {
      "const": "context-cache-entry"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "authority": {
      "const": "generated-non-canonical"
    },
    "created_at": {
      "$ref": "#/$defs/date_time"
    },
    "artifact_type": {
      "$ref": "#/$defs/id"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "revision": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "deterministic",
            "model",
            "provider",
            "human"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "reference",
          "digest",
          "revision"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": [
              "source",
              "configuration",
              "rule",
              "decision",
              "summary",
              "diagnostic",
              "tool"
            ]
          },
          "reference": {
            "$ref": "#/$defs/text"
          },
          "digest": {
            "$ref": "#/$defs/digest"
          },
          "revision": {
            "oneOf": [
              {
                "$ref": "#/$defs/text"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "digest"
      ],
      "properties": {
        "reference": {
          "$ref": "#/$defs/text"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "identity_sha256": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.:/+@-]+$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "date_time": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    }
  }
}
