{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/powerpuff-kitty/agentic-harness/catalog/schema/architecture-reference.v1.schema.json",
  "title": "Agentic Harness Architecture Reference Snapshot v1",
  "description": "Revision-bound public-project reference metadata for validating Architecture Graph expressiveness. A valid snapshot records reviewed evidence; it does not prove the source repository is unchanged or currently conformant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "kind",
    "id",
    "source",
    "reviewed_at",
    "graph_path",
    "evidence",
    "task_routes",
    "limitations"
  ],
  "properties": {
    "format_version": { "const": 1 },
    "kind": { "const": "architecture-reference-snapshot" },
    "id": { "$ref": "#/$defs/id" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "branch", "visibility"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "branch": { "$ref": "#/$defs/text" },
        "visibility": { "const": "public" }
      }
    },
    "reviewed_at": {
      "type": "string",
      "format": "date"
    },
    "graph_path": { "$ref": "#/$defs/path" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "task_routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/task_route" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.:/+-]+$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "git_blob_sha", "role"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "git_blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "role": {
          "enum": [
            "architecture-truth",
            "workspace-manifest",
            "dependency-policy",
            "package-boundary",
            "other"
          ]
        }
      }
    },
    "task_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "expected_capability_ids"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "expected_capability_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}
