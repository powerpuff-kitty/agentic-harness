{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-harness.dev/schema/rule-inventory.v1.schema.json",
  "title": "Agentic Harness RuleInventory v1",
  "description": "Explicitly reviewed rule excerpts and declared context. Unordered rule inventory, not automatic policy discovery, trusted authority, or permission. Scope lists, conditions and exceptions are unordered exact-string sets; selectors are not evaluated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "kind",
    "target",
    "rules"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "kind": {
      "const": "rule-inventory"
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "statement",
        "authority",
        "strength",
        "directive",
        "scope",
        "conditions",
        "exceptions",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._:/-]*$",
          "not": {
            "pattern": "\\s"
          }
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._:/-]*$",
          "not": {
            "pattern": "\\s"
          }
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "not": {
            "pattern": "[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]"
          }
        },
        "authority": {
          "enum": [
            "policy",
            "project-truth",
            "adr",
            "pack",
            "skill",
            "prompt"
          ]
        },
        "strength": {
          "enum": [
            "mandatory",
            "advisory"
          ]
        },
        "directive": {
          "enum": [
            "require",
            "forbid",
            "allow"
          ]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base",
            "include",
            "exclude"
          ],
          "properties": {
            "base": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "not": {
                "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
              }
            },
            "include": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "not": {
                  "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
                }
              },
              "uniqueItems": true,
              "maxItems": 32,
              "minItems": 1
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "not": {
                  "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
                }
              },
              "uniqueItems": true,
              "maxItems": 32
            }
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "not": {
              "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
            }
          },
          "uniqueItems": true,
          "maxItems": 32
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "not": {
              "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
            }
          },
          "uniqueItems": true,
          "maxItems": 32
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference",
            "sha256",
            "start_line",
            "end_line"
          ],
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "not": {
                "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
              }
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "minLength": 71,
              "maxLength": 71
            },
            "start_line": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            "end_line": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            }
          }
        }
      }
    }
  }
}
