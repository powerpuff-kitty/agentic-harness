{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-harness.dev/schema/context-checkpoint.v1.schema.json",
  "title": "Agentic Harness ContextCheckpoint v1",
  "description": "Optional generated continuation aid. Historical supplied observations are not authenticated evidence, current verification, policy or authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "kind",
    "id",
    "authority",
    "created_at",
    "producer",
    "task",
    "sources",
    "notes",
    "checks",
    "open_items",
    "next_steps"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "kind": {
      "const": "context-checkpoint"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "authority": {
      "const": "navigation-only"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "producer": {
      "$ref": "#/$defs/text"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "goal",
        "scope",
        "base_revision",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "goal": {
          "$ref": "#/$defs/text"
        },
        "scope": {
          "$ref": "#/$defs/text"
        },
        "base_revision": {
          "oneOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "in-progress",
            "blocked",
            "review-ready"
          ]
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "maxItems": 256
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "statement",
          "source_ids"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": [
              "observation",
              "inference",
              "decision-reference"
            ]
          },
          "statement": {
            "$ref": "#/$defs/text"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "maxItems": 128,
            "minItems": 1,
            "uniqueItems": true
          }
        }
      },
      "maxItems": 64
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "attempt",
          "command",
          "status",
          "input_source_ids",
          "evidence_source_ids",
          "output_complete"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "$ref": "#/$defs/id"
          },
          "attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 128
          },
          "command": {
            "oneOf": [
              {
                "$ref": "#/$defs/text"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not-run",
              "blocked",
              "unknown"
            ]
          },
          "input_source_ids": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "evidence_source_ids": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "output_complete": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "maxItems": 128
    },
    "open_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "blocking",
          "source_ids"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "description": {
            "$ref": "#/$defs/text"
          },
          "blocking": {
            "type": "boolean"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "maxItems": 128,
            "uniqueItems": true
          }
        }
      },
      "maxItems": 64
    },
    "next_steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      },
      "maxItems": 16,
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reference",
        "role",
        "availability",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "reference": {
          "$ref": "#/$defs/text"
        },
        "role": {
          "enum": [
            "instruction",
            "criterion",
            "source",
            "decision",
            "diagnostic"
          ]
        },
        "availability": {
          "enum": [
            "recorded",
            "unavailable"
          ]
        },
        "sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "const": "recorded"
              }
            }
          },
          "then": {
            "properties": {
              "sha256": {
                "$ref": "#/$defs/digest"
              }
            }
          },
          "else": {
            "properties": {
              "sha256": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
