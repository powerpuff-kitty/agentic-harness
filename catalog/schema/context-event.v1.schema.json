{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-harness.dev/schema/context-event.v1.schema.json",
  "title": "Agentic Harness append-only context event v1",
  "description": "Compact historical event referencing canonical truth/evidence. It is navigation/history, not a replacement for ADRs, project truth, checks, or authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "kind",
    "id",
    "authority",
    "sequence",
    "occurred_at",
    "producer",
    "event_type",
    "subject",
    "statement",
    "canonical_refs",
    "evidence_refs",
    "supersedes"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "kind": {
      "const": "context-event"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "authority": {
      "const": "historical-navigation-only"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "occurred_at": {
      "$ref": "#/$defs/date_time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "deterministic",
            "model",
            "provider",
            "human"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "event_type": {
      "enum": [
        "decision",
        "constraint",
        "change",
        "verification",
        "unresolved"
      ]
    },
    "subject": {
      "$ref": "#/$defs/text"
    },
    "statement": {
      "$ref": "#/$defs/text"
    },
    "canonical_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "supersedes": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.:/+@-]+$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "date_time": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference",
        "digest",
        "revision"
      ],
      "properties": {
        "kind": {
          "enum": [
            "adr",
            "project-truth",
            "task",
            "source",
            "check",
            "artifact"
          ]
        },
        "reference": {
          "$ref": "#/$defs/text"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "revision": {
          "oneOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
