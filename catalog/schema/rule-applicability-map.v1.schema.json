{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-harness.dev/schema/rule-applicability-map.v1.schema.json",
  "title": "Agentic Harness RuleApplicabilityMap v1",
  "description": "Caller-reviewed rule-to-target membership for overlap/applicability review. It does not infer selector semantics, source completeness, or authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "kind",
    "target",
    "semantics",
    "rules"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "kind": {
      "const": "rule-applicability-map"
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
      }
    },
    "semantics": {
      "const": "caller-resolved-targets-v1"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:/-]*$",
      "not": {
        "pattern": "\\s"
      }
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "targets"
      ],
      "properties": {
        "rule_id": {
          "$ref": "#/$defs/id"
        },
        "targets": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/target"
          }
        }
      }
    }
  }
}
