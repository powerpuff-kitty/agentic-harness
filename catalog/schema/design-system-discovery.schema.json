{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-harness.dev/schema/design-system-discovery.schema.json",
  "title": "Repository static design-system discovery configuration",
  "type": "object",
  "properties": {
    "format_version": {
      "const": 1
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_components": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
