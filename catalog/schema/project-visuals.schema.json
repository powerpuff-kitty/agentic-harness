{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:agentic-harness:project-visuals:1","title":"Project visual presentation extension v1","description":"Portable assets and visual sections. Semantic cross-reference, rights review and byte checks remain required. Does not validate an entire product catalogue or execute templates.","type":"object","additionalProperties":false,"required":["schemaVersion","projectId","assets","sections"],"properties":{"schemaVersion":{"const":1},"projectId":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},"assets":{"type":"object","minProperties":1,"maxProperties":48,"propertyNames":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},"additionalProperties":{"$ref":"#/$defs/asset"}},"sections":{"type":"array","minItems":1,"maxItems":40,"items":{"$ref":"#/$defs/section"}}},"$defs":{"asset":{"type":"object","additionalProperties":false,"required":["file","kind","alt","width","height","sha256","credit","rights"],"properties":{"file":{"type":"string","maxLength":200,"pattern":"^(?:[a-z0-9][a-z0-9-]*/)*[a-z0-9][a-z0-9-]*\\.(?:png|jpg|jpeg|webp)$"},"kind":{"enum":["photograph","screenshot","logo","artwork"]},"alt":{"type":"string","minLength":1,"maxLength":500,"pattern":"^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]+$"},"width":{"type":"integer","minimum":1,"maximum":16384},"height":{"type":"integer","minimum":1,"maximum":16384},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"credit":{"type":"string","minLength":1,"maxLength":200,"pattern":"^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]+$"},"rights":{"type":"object","additionalProperties":false,"required":["status","basis","notice"],"properties":{"status":{"const":"approved"},"basis":{"enum":["owned","licensed","permission"]},"notice":{"type":"string","minLength":1,"maxLength":500,"pattern":"^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]+$"}}}}},"item":{"type":"object","additionalProperties":false,"required":["asset","caption"],"properties":{"asset":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},"caption":{"type":"string","minLength":1,"maxLength":1200,"pattern":"^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]+$"},"fit":{"enum":["contain","cover"]},"ratio":{"enum":["natural","wide","landscape","square","portrait"]}}},"section":{"type":"object","additionalProperties":false,"required":["id","title","type","modes","purpose","layout","items"],"properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},"title":{"type":"string","minLength":1,"maxLength":150,"pattern":"^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]+$"},"type":{"const":"visual"},"modes":{"type":"array","minItems":1,"maxItems":3,"uniqueItems":true,"items":{"enum":["overview","design","design-system"]}},"purpose":{"enum":["cover","context","identity","foundations","application","interface","workflow"]},"layout":{"enum":["full","split","dominant-left","dominant-right","triptych","mosaic"]},"surface":{"enum":["paper","muted","ink"]},"frame":{"enum":["none","line"]},"corners":{"enum":["square","soft"]},"spacing":{"enum":["compact","comfortable","generous"]},"items":{"type":"array","minItems":1,"maxItems":4,"items":{"$ref":"#/$defs/item"}}},"allOf":[{"if":{"properties":{"layout":{"const":"full"}}},"then":{"properties":{"items":{"minItems":1,"maxItems":1}}}},{"if":{"properties":{"layout":{"const":"split"}}},"then":{"properties":{"items":{"minItems":2,"maxItems":2}}}},{"if":{"properties":{"layout":{"const":"dominant-left"}}},"then":{"properties":{"items":{"minItems":2,"maxItems":2}}}},{"if":{"properties":{"layout":{"const":"dominant-right"}}},"then":{"properties":{"items":{"minItems":2,"maxItems":2}}}},{"if":{"properties":{"layout":{"const":"triptych"}}},"then":{"properties":{"items":{"minItems":3,"maxItems":3}}}},{"if":{"properties":{"layout":{"const":"mosaic"}}},"then":{"properties":{"items":{"minItems":4,"maxItems":4}}}}]}}}
